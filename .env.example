# AITestHub Docker Compose environment configuration.
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- PostgreSQL ---
POSTGRES_DB=aitesthub
POSTGRES_USER=aitesthub
POSTGRES_PASSWORD=change-me-strong-password
# Host port for the PostgreSQL container (5433 by default to avoid
# clashing with a locally installed PostgreSQL on 5432).
POSTGRES_PORT=5433

# --- EVREN LLM API (server-side secret; NEVER expose to the frontend) ---
EVREN_API_KEY=

# --- Host ports ---
BACKEND_PORT=5098
FRONTEND_PORT=5173
